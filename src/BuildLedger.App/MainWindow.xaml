<Window x:Class="BuildLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BuildLedger.App"
        xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
        xmlns:views="clr-namespace:BuildLedger.App.Views"
        mc:Ignorable="d"
        Title="BuildLedger ERP" Height="820" Width="1360" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}"><views:CustomersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><views:ProductsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}"><views:SuppliersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}"><views:PurchasesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}"><views:SalesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}"><views:PaymentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><views:InventoryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpensesViewModel}"><views:ExpensesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><views:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}"><views:BackupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><views:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView/></DataTemplate>

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSidebar}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Margin="12,2" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="14,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SidebarHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SidebarActive}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSidebarActive}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.SidebarBg}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,24">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Primary}">
                        <TextBlock Text="BL" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                    </Border>
                    <TextBlock Text="BuildLedger" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12,8,12,16" Padding="14,12" CornerRadius="10"
                        Background="{DynamicResource Brush.SidebarHover}">
                    <StackPanel>
                        <TextBlock Text="{Binding UserFullName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" Foreground="{DynamicResource Brush.TextSidebar}" FontSize="11.5" Margin="0,2,0,10"/>
                        <Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavItemStyle}" Command="{Binding SelectCommand}">
                                    <TextBlock Text="{Binding Label}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="28"/>
    </Grid>
</Window>
