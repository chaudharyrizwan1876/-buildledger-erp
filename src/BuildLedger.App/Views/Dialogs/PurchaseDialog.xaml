<Window x:Class="BuildLedger.App.Views.Dialogs.PurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Purchase" Height="580" Width="760" MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="New Purchase" Style="{StaticResource Text.H1}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Suppliers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SupplierId}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Invoice Number *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Date" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding PurchaseDate}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="+ Add Line" Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Left" Margin="12" Click="AddLine_Click"/>
                <DataGrid ItemsSource="{Binding Lines}" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Product" ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValueBinding="{Binding ProductId}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="Unit Rate" Binding="{Binding UnitRate, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat={}Rs. {0:N0}}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Style="{StaticResource Button.Secondary}" Padding="8,2" Click="RemoveLine_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Tag="Notes (optional)"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Discount" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Tax" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding TaxAmount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Total, StringFormat={}Rs. {0:N0}}" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="20,0,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save Purchase" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
