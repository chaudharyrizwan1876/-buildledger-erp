<Window x:Class="BuildLedger.App.Views.Dialogs.ExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Expense" Height="500" Width="440" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Background}" ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Record Expense" Style="{StaticResource Text.H1}" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Category *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectedValue="{Binding CategoryId}" Margin="0,0,0,14"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Amount *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Date" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding ExpenseDate}"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Method" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Margin="0,0,0,14"/>

            <TextBlock Text="Payee" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Payee, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="Notes" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Save Expense" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
