<Window x:Class="BuildLedger.App.Views.Dialogs.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product" Height="580" Width="460" MinHeight="480" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Product Name *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Category *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding CategoryId}" Margin="0,0,0,14"/>

                <TextBlock Text="Unit *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding UnitId}" Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Purchase Rate" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PurchaseRate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Sale Rate" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding SaleRate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Minimum Stock Level" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                <TextBox Text="{Binding MinimumStockLevel, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Description" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Save Product" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
