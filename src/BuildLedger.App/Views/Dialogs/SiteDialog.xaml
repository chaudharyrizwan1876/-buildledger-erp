<Window x:Class="BuildLedger.App.Views.Dialogs.SiteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Construction Site" Height="480" Width="460" MinHeight="420" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Text.H1}" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Site Name *" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Project Type" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ProjectType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Contact Person" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="Site Address" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SiteAddress, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" Margin="0,0,0,14"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Save Site" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
