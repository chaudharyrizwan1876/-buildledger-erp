<UserControl x:Class="BuildLedger.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource Text.Display}"/>
                    <TextBlock Text="Today's snapshot of your business" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="New Sale" Command="{Binding GoToNewSaleCommand}" Margin="0,0,8,0"/>
                    <Button Content="New Payment" Style="{StaticResource Button.Secondary}" Command="{Binding GoToNewPaymentCommand}" Margin="0,0,8,0"/>
                    <Button Content="New Purchase" Style="{StaticResource Button.Secondary}" Command="{Binding GoToNewPurchaseCommand}"/>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TODAY'S SALES" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.TodaySales, StringFormat={}Rs. {0:N0}}" Style="{StaticResource Text.KpiValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="PAYMENTS RECEIVED TODAY" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.TodayPaymentsReceived, StringFormat={}Rs. {0:N0}}" Style="{StaticResource Text.KpiValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL RECEIVABLES" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.TotalReceivables, StringFormat={}Rs. {0:N0}}" Style="{StaticResource Text.KpiValue}"
                                   Foreground="{DynamicResource Brush.Danger}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER ADVANCES" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.TotalAdvances, StringFormat={}Rs. {0:N0}}" Style="{StaticResource Text.KpiValue}"
                                   Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="STOCK VALUE (AT COST)" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.CurrentStockValue, StringFormat={}Rs. {0:N0}}" Style="{StaticResource Text.KpiValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="LOW STOCK PRODUCTS" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.LowStockProductCount}" Style="{StaticResource Text.KpiValue}"
                                   Foreground="{DynamicResource Brush.Warning}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE CUSTOMERS" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding Summary.ActiveCustomerCount}" Style="{StaticResource Text.KpiValue}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent Sales" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding Summary.RecentSales}" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="140"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd MMM yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}Rs. {0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding AmountDue, StringFormat={}Rs. {0:N0}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
