<UserControl x:Class="BuildLedger.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:InventoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Inventory" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="{Binding StockValuation, StringFormat={}Stock valuation at cost: Rs. {0:N0}}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Adjust Stock" Click="AdjustStock_Click"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Stock Movement History" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
                <DataGrid ItemsSource="{Binding Movements}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat=dd MMM yyyy HH:mm}" Width="150"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="140"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding QuantityChange, StringFormat={}{0:N2}}" Width="100"/>
                        <DataGridTextColumn Header="Resulting Stock" Binding="{Binding ResultingStock, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
