<UserControl x:Class="BuildLedger.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:BackupViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="Transaction-consistent SQLite backups using VACUUM INTO" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="A local backup on the same hard drive is not sufficient protection against drive failure. Regularly copy backups to a USB drive, network share, or cloud-synced folder."
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Create Backup Now" Click="CreateBackup_Click" Margin="0,0,8,0"/>
                    <Button Content="Backup To Folder..." Style="{StaticResource Button.Secondary}" Click="CreateBackupTo_Click" Margin="0,0,8,0"/>
                    <Button Content="Restore From File..." Style="{StaticResource Button.Secondary}" Click="Restore_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource Brush.Success}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Backup History" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
                <DataGrid ItemsSource="{Binding History}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding BackupDateUtc, StringFormat=dd MMM yyyy HH:mm}" Width="160"/>
                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*"/>
                        <DataGridTextColumn Header="Size (KB)" Binding="{Binding FileSizeBytes, StringFormat={}{0:N0}}" Width="100"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding IsManual}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
