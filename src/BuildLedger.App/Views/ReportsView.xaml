<UserControl x:Class="BuildLedger.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reports Center" Style="{StaticResource Text.Display}" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" Text="Sales, payments, receivables and supplier balances" Style="{StaticResource Text.Secondary}"
                    VerticalAlignment="Bottom" Margin="0,0,0,16" HorizontalAlignment="Left"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,16,0"/>
                <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,16,0"/>
                <Button Content="Today" Style="{StaticResource Button.Secondary}" Command="{Binding SetTodayCommand}" Margin="0,0,8,0"/>
                <Button Content="This Week" Style="{StaticResource Button.Secondary}" Command="{Binding SetThisWeekCommand}" Margin="0,0,8,0"/>
                <Button Content="This Month" Style="{StaticResource Button.Secondary}" Command="{Binding SetThisMonthCommand}" Margin="0,0,8,0"/>
                <Button Content="Last Month" Style="{StaticResource Button.Secondary}" Command="{Binding SetLastMonthCommand}" Margin="0,0,8,0"/>
                <Button Content="Run" Command="{Binding RunAllCommand}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Sales">
                <Border Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding SalesReport}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="130"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd MMM yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}Rs. {0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat={}Rs. {0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding AmountDue, StringFormat={}Rs. {0:N0}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Payments">
                <Border Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding PaymentsReport}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="140"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate, StringFormat=dd MMM yyyy}" Width="120"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}Rs. {0:N0}}" Width="120"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Receivables">
                <Border Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding Receivables}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140"/>
                            <DataGridTextColumn Header="Balance Owed" Binding="{Binding CurrentBalance, StringFormat={}Rs. {0:N0}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
            <TabItem Header="Supplier Balances">
                <Border Style="{StaticResource Card}">
                    <DataGrid ItemsSource="{Binding SupplierBalances}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="140"/>
                            <DataGridTextColumn Header="Balance Owed" Binding="{Binding CurrentBalance, StringFormat={}Rs. {0:N0}}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
