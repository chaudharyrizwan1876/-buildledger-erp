<UserControl x:Class="BuildLedger.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:SalesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sales &amp; Delivery" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Invoices delivered to customers and sites" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Sale" Click="NewSale_Click"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Sales}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="130"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat=dd MMM yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="150"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}Rs. {0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, StringFormat={}Rs. {0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding AmountDue, StringFormat={}Rs. {0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
