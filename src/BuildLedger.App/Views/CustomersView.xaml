<UserControl x:Class="BuildLedger.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BuildLedger.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:CustomersViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Customers" Style="{StaticResource Text.Display}"/>
                <TextBlock Text="Search by name, phone, ID, or site name" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Customer" Click="NewCustomer_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,12"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search name, phone, ID or site..."/>
                    <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance, StringFormat={}Rs. {0:N0}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding CurrentBalance, Converter={StaticResource BalanceToBrushConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding SelectedCustomerDetail, Converter={StaticResource NullToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedCustomerDetail.FullName}" Style="{StaticResource Text.H1}"/>
                                <TextBlock Text="{Binding SelectedCustomerDetail.Phone}" Style="{StaticResource Text.Secondary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Edit" Style="{StaticResource Button.Secondary}" Click="EditCustomer_Click" Margin="0,0,8,0"/>
                                <Button Content="+ Site" Click="NewSite_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Consolidated Balance: " Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedCustomerDetail.CurrentBalance, StringFormat={}Rs. {0:N0}}"
                                           FontWeight="Bold"
                                           Foreground="{Binding SelectedCustomerDetail.CurrentBalance, Converter={StaticResource BalanceToBrushConverter}}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Construction Sites" Style="{StaticResource Text.H2}" Margin="0,20,0,10"/>
                        <ItemsControl ItemsSource="{Binding Sites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SiteAddress}" Style="{StaticResource Text.Caption}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentBalance, StringFormat={}Rs. {0:N0}}"
                                                       Foreground="{Binding CurrentBalance, Converter={StaticResource BalanceToBrushConverter}}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Ledger" Style="{StaticResource Text.H2}" Margin="0,16,0,10"/>
                        <DataGrid ItemsSource="{Binding Ledger}" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding EntryDate, StringFormat=dd MMM yyyy}" Width="110"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="110"/>
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceNumber}" Width="140"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}Rs. {0:N0}}" Width="110"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding RunningBalance, StringFormat={}Rs. {0:N0}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
