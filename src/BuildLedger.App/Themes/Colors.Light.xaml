<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="Color.Primary">#1F5FBF</Color>
    <Color x:Key="Color.PrimaryDark">#164A99</Color>
    <Color x:Key="Color.PrimaryLight">#E8F0FC</Color>
    <Color x:Key="Color.Accent">#D97706</Color>

    <!-- Semantic -->
    <Color x:Key="Color.Success">#15803D</Color>
    <Color x:Key="Color.SuccessBg">#E7F6EC</Color>
    <Color x:Key="Color.Danger">#B91C1C</Color>
    <Color x:Key="Color.DangerBg">#FDECEC</Color>
    <Color x:Key="Color.Warning">#B45309</Color>
    <Color x:Key="Color.WarningBg">#FEF3E2</Color>
    <Color x:Key="Color.Info">#0369A1</Color>
    <Color x:Key="Color.InfoBg">#E7F4FC</Color>

    <!-- Surfaces -->
    <Color x:Key="Color.Background">#F4F6F9</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F9FAFC</Color>
    <Color x:Key="Color.SidebarBg">#14213A</Color>
    <Color x:Key="Color.SidebarHover">#1E2E52</Color>
    <Color x:Key="Color.SidebarActive">#1F5FBF</Color>
    <Color x:Key="Color.Border">#E2E6EC</Color>
    <Color x:Key="Color.BorderStrong">#C7CEDA</Color>

    <!-- Text -->
    <Color x:Key="Color.TextPrimary">#111827</Color>
    <Color x:Key="Color.TextSecondary">#5B6472</Color>
    <Color x:Key="Color.TextMuted">#8A93A3</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.TextSidebar">#C3CCE0</Color>
    <Color x:Key="Color.TextSidebarActive">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}"/>
    <SolidColorBrush x:Key="Brush.PrimaryLight" Color="{StaticResource Color.PrimaryLight}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessBg" Color="{StaticResource Color.SuccessBg}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.WarningBg" Color="{StaticResource Color.WarningBg}"/>
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.InfoBg" Color="{StaticResource Color.InfoBg}"/>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.SidebarBg" Color="{StaticResource Color.SidebarBg}"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="{StaticResource Color.SidebarHover}"/>
    <SolidColorBrush x:Key="Brush.SidebarActive" Color="{StaticResource Color.SidebarActive}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSidebar" Color="{StaticResource Color.TextSidebar}"/>
    <SolidColorBrush x:Key="Brush.TextSidebarActive" Color="{StaticResource Color.TextSidebarActive}"/>

</ResourceDictionary>
